# Everything listed here is NOT copied into the image.

# Secrets and local settings: an image must never contain them. The container gets them when it starts.
.env
.env.*

# Things the running API does not need (smaller image, faster builds)
.git
.github
.venv
venv
__pycache__
*.pyc
.pytest_cache
*.egg-info
.DS_Store
*.log

# Not part of this image
web
docs
tests
infra
docker
data
eval_results
storage
Dockerfile
docker-compose.yml
